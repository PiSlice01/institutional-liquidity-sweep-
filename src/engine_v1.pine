//@version=5
strategy("Institutional Liquidity Sweep Engine V2", 
     overlay=true, 
     initial_capital=1000, 
     default_qty_type=strategy.cash, 
     default_qty_value=20, 
     currency=currency.USD, 
     slippage=3, 
     commission_type=strategy.commission.cash_per_contract, 
     commission_value=0.07, 
     max_bars_back=500)

// =============================================================================
// 1. INPUT PARAMETERS & USER CONFIGURATION
// =============================================================================
var string G_STRAT   = "Strategy Parameters"
var string G_FILTER  = "Trend & Volatility Filters"
var string G_RISK    = "Risk Management"

// Strategy Inputs
i_targetRR       = input.float(2.50, "Target Risk-to-Reward (R:R)", group=G_STRAT, tooltip="Target R:R limit before friction haircuts")
i_lookback       = input.int(10, "Sweep Lookback Bars (30m)", minval=5, maxval=50, group=G_STRAT)
i_wickRatio      = input.float(0.35, "Min Sweep Wick Ratio", minval=0.1, maxval=0.8, group=G_STRAT)

// Trend & Volatility Inputs
i_useTrendFilter = input.bool(true, "Enable HTF Trend Filter (4H 50 / 1H 200 EMA)", group=G_FILTER)
i_useAtrGate     = input.bool(true, "Enable Volatility Expansion Gate (ATR > SMA)", group=G_FILTER)
i_atrMultiplier  = input.float(1.0, "ATR Volatility Multiplier Threshold", minval=0.5, step=0.1, group=G_FILTER)

// Risk Inputs
i_riskUSD        = input.float(20.0, "Fixed Dollar Risk ($)", minval=1.0, group=G_RISK)
i_maxDailyLoss   = input.float(40.0, "Hard Daily Drawdown Breaker ($)", minval=5.0, group=G_RISK)

// =============================================================================
// 2. INDICATORS & HTF SECURITY FETCH
// =============================================================================
// Non-repainting HTF Trend EMAs
ema4H_50  = request.security(syminfo.tickerid, "240", ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_off)
ema1H_200 = request.security(syminfo.tickerid, "60", ta.ema(close, 200)[1], barmerge.gaps_off, barmerge.lookahead_off)

// Volatility Expansion Calculation (30m)
atrVal    = ta.atr(14)
atrSmaVal = ta.sma(atrVal, 20)
isVolatile = not i_useAtrGate or (atrVal >= atrSmaVal * i_atrMultiplier)

// Market Structure Lookbacks (30m)
highLevel = ta.highest(high, i_lookback)[1]
lowLevel  = ta.lowest(low, i_lookback)[1]

// =============================================================================
// 3. DAILY CIRCUIT BREAKER & SESSION FILTERS
// =============================================================================
// Track Daily Realized Equity for Hard Loss Limit
var float dailyStartEquity = strategy.equity
if ta.change(time("D"))
    dailyStartEquity := strategy.equity

dailyDrawdown  = dailyStartEquity - strategy.equity
isDailyBlocked = dailyDrawdown >= i_maxDailyLoss

// Session Definition (Adjusted for European/NY Overlap and Tokyo)
isSession = not na(time(timeframe.period, "0600-1700:23456")) or not na(time(timeframe.period, "1900-1500:12345"))

// =============================================================================
// 4. SIGNAL GENERATION LOGIC
// =============================================================================
candleRange = high - low
lowerWick   = math.min(open, close) - low
upperWick   = high - math.max(open, close)

// Bullish Sweep: Price pierces 30m low, rejects back above, wick >= 35% of body
bullishSweep = (low < lowLevel) and (close > lowLevel) and (lowerWick >= candleRange * i_wickRatio)

// Bearish Sweep: Price pierces 30m high, rejects back below, wick >= 35% of body
bearishSweep = (high > highLevel) and (close < highLevel) and (upperWick >= candleRange * i_wickRatio)

// HTF Trend Alignment Checks
trendBullish = not i_useTrendFilter or (close > ema4H_50 and close > ema1H_200)
trendBearish = not i_useTrendFilter or (close < ema4H_50 and close < ema1H_200)

// Final Execution Triggers
longCondition  = bullishSweep and trendBullish and isVolatile and isSession and not isDailyBlocked
shortCondition = bearishSweep and trendBearish and isVolatile and isSession and not isDailyBlocked

// =============================================================================
// 5. DYNAMIC POSITION SIZING & ORDER EXECUTION
// =============================================================================
if (longCondition and strategy.position_size == 0)
    stopDistance = close - low
    if stopDistance > 0
        units = i_riskUSD / (stopDistance * syminfo.pointvalue)
        takeProfitPrice = close + (stopDistance * i_targetRR)
        stopLossPrice   = low
        strategy.entry("Sweep Long", strategy.long, qty=units)
        strategy.exit("Exit Long", "Sweep Long", limit=takeProfitPrice, stop=stopLossPrice)

if (shortCondition and strategy.position_size == 0)
    stopDistance = high - close
    if stopDistance > 0
        units = i_riskUSD / (stopDistance * syminfo.pointvalue)
        takeProfitPrice = close - (stopDistance * i_targetRR)
        stopLossPrice   = high
        strategy.entry("Sweep Short", strategy.short, qty=units)
        strategy.exit("Exit Short", "Sweep Short", limit=takeProfitPrice, stop=stopLossPrice)

// =============================================================================
// 6. VISUALIZATIONS
// =============================================================================
plot(i_useTrendFilter ? ema4H_50 : na, "4H 50 EMA", color=color.rgb(33, 150, 243), linewidth=2)
plot(i_useTrendFilter ? ema1H_200 : na, "1H 200 EMA", color=color.rgb(233, 30, 99), linewidth=2)

plotshape(longCondition, "Long Sweep Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(shortCondition, "Short Sweep Signal", shape.triangledown, location.abovebar, color.red, size=size.small)
